// Loom's built-in key bindings.
//
// Contexts, from the root to the focused element:
//   Workspace os=… surface=editor|diff|settings|keymap|home|welcome|empty
//     Editor extension=…   the code editor has focus
//       Vim mode=normal|visual|insert|replace   Vim mode is on (Settings)
//     Terminal            the terminal has focus
//     Input                a single-line text field has focus
//                          (Input CommitMessage: the Source Control message)
//     Menu                 an editor, Explorer, tab or Source Control menu
//                          is open (deepest)
//   Dialog CloseConfirmation | Dialog CloneRepository | Dialog StashSwitch
//     | Dialog GitConfirm | Dialog BranchPicker   (modal, separate roots)
//
// Users override these in keymap.json: open the Keymap page
// (workspace::OpenKeymap) and choose "Edit keymap.json".
[
  {
    "context": "Workspace",
    "bindings": {
      "secondary-b": "workspace::ToggleDrawer",
      "secondary-shift-f": "workspace::OpenSearch",
      "secondary-shift-g": "workspace::ToggleSourceControl",
      "secondary-shift-h": "workspace::ToggleGitPanel",
      "secondary-`": "workspace::ToggleTerminal",
      "secondary-,": "workspace::OpenSettings",
      "secondary-k secondary-s": "workspace::OpenKeymap",
      "secondary-=": "workspace::IncreaseFontSize",
      "secondary-+": "workspace::IncreaseFontSize",
      "secondary--": "workspace::DecreaseFontSize",
      "secondary-0": "workspace::ResetFontSize",
      "escape": "workspace::CloseOverlay",
      "secondary-w": "pane::CloseActiveItem",
      "ctrl-tab": "pane::ActivateNextItem",
      "ctrl-shift-tab": "pane::ActivatePrevItem",
      "secondary-1": ["pane::ActivateItem", 0],
      "secondary-2": ["pane::ActivateItem", 1],
      "secondary-3": ["pane::ActivateItem", 2],
      "secondary-4": ["pane::ActivateItem", 3],
      "secondary-5": ["pane::ActivateItem", 4],
      "secondary-6": ["pane::ActivateItem", 5],
      "secondary-7": ["pane::ActivateItem", 6],
      "secondary-8": ["pane::ActivateItem", 7],
      "secondary-9": "pane::ActivateLastItem",
      "secondary-\\": "pane::SplitRight",
      "secondary-k left": "pane::SplitLeft",
      "secondary-k right": "pane::SplitRight",
      "secondary-k up": "pane::SplitUp",
      "secondary-k down": "pane::SplitDown",
      "alt-left": "pane::GoBack",
      "alt-right": "pane::GoForward",
      "secondary-shift-o": "outline::Toggle",
      "secondary-shift-m": "workspace::ToggleProblems",
      "shift-alt-h": "editor::ShowCallHierarchy",
      "secondary-t": "project_symbols::Toggle",
      "secondary-k secondary-left": "workspace::ActivatePaneLeft",
      "secondary-k secondary-right": "workspace::ActivatePaneRight",
      "secondary-k secondary-up": "workspace::ActivatePaneUp",
      "secondary-k secondary-down": "workspace::ActivatePaneDown"
    }
  },
  {
    "context": "Diff",
    "bindings": {
      "secondary-a": "editor::SelectAll",
      "secondary-c": "editor::Copy",
      "escape": "editor::Cancel"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "secondary-s": "editor::Save",
      "secondary-z": "editor::Undo",
      "secondary-shift-z": "editor::Redo",
      "secondary-y": "editor::Redo",
      "secondary-a": "editor::SelectAll",
      "secondary-c": "editor::Copy",
      "secondary-x": "editor::Cut",
      "secondary-v": "editor::Paste",
      "escape": "editor::Cancel",
      "left": "editor::MoveLeft",
      "right": "editor::MoveRight",
      "up": "editor::MoveUp",
      "down": "editor::MoveDown",
      "shift-left": "editor::SelectLeft",
      "shift-right": "editor::SelectRight",
      "shift-up": "editor::SelectUp",
      "shift-down": "editor::SelectDown",
      "secondary-left": "editor::MoveToPreviousWordStart",
      "secondary-right": "editor::MoveToNextWordEnd",
      "secondary-shift-left": "editor::SelectToPreviousWordStart",
      "secondary-shift-right": "editor::SelectToNextWordEnd",
      "home": "editor::MoveToBeginningOfLine",
      "end": "editor::MoveToEndOfLine",
      "shift-home": "editor::SelectToBeginningOfLine",
      "shift-end": "editor::SelectToEndOfLine",
      "secondary-home": "editor::MoveToBeginning",
      "secondary-end": "editor::MoveToEnd",
      "secondary-shift-home": "editor::SelectToBeginning",
      "secondary-shift-end": "editor::SelectToEnd",
      "pageup": "editor::MovePageUp",
      "pagedown": "editor::MovePageDown",
      "shift-pageup": "editor::SelectPageUp",
      "shift-pagedown": "editor::SelectPageDown",
      "backspace": "editor::Backspace",
      "shift-backspace": "editor::Backspace",
      "delete": "editor::Delete",
      "shift-delete": "editor::Delete",
      "secondary-backspace": "editor::DeleteToPreviousWordStart",
      "secondary-delete": "editor::DeleteToNextWordEnd",
      "enter": "editor::Newline",
      "shift-enter": "editor::Newline",
      "tab": "editor::Tab",
      "shift-tab": "editor::Backtab",
      "alt-z": "editor::ToggleSoftWrap",
      "secondary-shift-[": "editor::Fold",
      "secondary-shift-]": "editor::Unfold",
      "secondary-k secondary-0": "editor::FoldAll",
      "secondary-k secondary-j": "editor::UnfoldAll",
      "alt-up": "editor::MoveLineUp",
      "alt-down": "editor::MoveLineDown",
      "shift-alt-up": "editor::DuplicateLineUp",
      "shift-alt-down": "editor::DuplicateLineDown",
      "secondary-shift-k": "editor::DeleteLine",
      "secondary-/": "editor::ToggleComment",
      "ctrl-space": "editor::ShowCompletions",
      "f2": "editor::Rename",
      "ctrl-shift-space": "editor::ShowSignatureHelp",
      "shift-alt-right": "editor::SelectLargerSyntaxNode",
      "shift-alt-left": "editor::SelectSmallerSyntaxNode",
      "secondary-.": "editor::ToggleCodeActions",
      "shift-alt-f": "editor::Format",
      "secondary-k secondary-f": "editor::FormatSelections",
      "f12": "editor::GoToDefinition",
      "secondary-f12": "editor::GoToImplementation",
      "secondary-shift-f12": "editor::GoToTypeDefinition",
      "alt-f12": "editor::GoToDeclaration",
      "secondary-alt-enter": "editor::PeekDefinition",
      "shift-f12": "editor::FindAllReferences",
      "secondary-k secondary-i": "editor::Hover",
      "f8": "editor::GoToDiagnostic",
      "shift-f8": "editor::GoToPreviousDiagnostic",
      "alt-f8": "editor::GoToConflict",
      "alt-shift-f8": "editor::GoToPreviousConflict"
    }
  },
  {
    // Filling in a snippet.
    "context": "Snippet",
    "bindings": {
      "tab": "editor::NextSnippetTabstop",
      "shift-tab": "editor::PreviousSnippetTabstop"
    }
  },
  {"context":"LanguagePeek","bindings":{"escape":"editor::ClosePeek","enter":"editor::OpenPeekTarget"}},
  {
    "context": "SnippetChoice",
    "bindings": {
      "ctrl-space": "editor::ShowSnippetChoices"
    }
  },
  {
    // Change overloads without moving the caret or the completion selection.
    "context": "SignatureHelp",
    "bindings": {
      "alt-up": "editor::PreviousSignature",
      "alt-down": "editor::NextSignature"
    }
  },
  {
    // A list over the code takes the keys that move through it. Everything
    // else (typing, deleting) still reaches the editor, or the list's own field.
    "context": "Popup",
    "bindings": {
      "up": "menu::SelectPrevious",
      "down": "menu::SelectNext",
      "ctrl-p": "menu::SelectPrevious",
      "ctrl-n": "menu::SelectNext",
      "pageup": "menu::PageUp",
      "pagedown": "menu::PageDown",
      "enter": "menu::Confirm",
      "tab": "menu::ConfirmWithTab",
      "escape": "menu::Cancel"
    }
  },
  {
    // Vim (Settings > Editor > Vim mode). Keys no binding claims go to Vim;
    // `null` hands a key that has an application binding to Vim instead.
    // Bind keys in a Vim context in keymap.json to take them back.
    "context": "Vim && mode != insert && mode != replace",
    "bindings": {
      "escape": null,
      "enter": null,
      "shift-enter": null,
      "backspace": null,
      "shift-backspace": null,
      "delete": null,
      "shift-delete": null,
      "tab": null,
      "shift-tab": null,
      "left": null,
      "right": null,
      "up": null,
      "down": null,
      "home": null,
      "end": null,
      "pageup": null,
      "pagedown": null,
      "ctrl-a": null,
      "ctrl-b": null,
      "ctrl-d": null,
      "ctrl-f": null,
      "ctrl-i": null,
      "ctrl-o": null,
      "ctrl-r": null,
      "ctrl-u": null,
      "ctrl-v": null,
      "ctrl-x": null
    }
  },
  {
    "context": "Vim && (mode == insert || mode == replace)",
    "bindings": {
      "escape": null,
      "backspace": null,
      "shift-backspace": null,
      "delete": null,
      "shift-delete": null,
      "enter": null,
      "shift-enter": null,
      "tab": null,
      "ctrl-o": null,
      "ctrl-r": null,
      "ctrl-u": null,
      "ctrl-w": null
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-c": "terminal::CopyOrInterrupt",
      "ctrl-shift-c": "terminal::Copy",
      "ctrl-v": "terminal::Paste",
      "shift-insert": "terminal::Paste",
      // These keys belong to the shell while the terminal has focus.
      "ctrl-w": null,
      "escape": null,
      "ctrl-tab": null,
      "ctrl-shift-tab": null,
      "secondary-\\": null,
      "secondary-k secondary-s": null,
      "secondary-k left": null,
      "secondary-k right": null,
      "secondary-k up": null,
      "secondary-k down": null,
      "secondary-k secondary-left": null,
      "secondary-k secondary-right": null,
      "secondary-k secondary-up": null,
      "secondary-k secondary-down": null
    }
  },
  {
    "context": "Input",
    "bindings": {
      // Text fields cancel their own edit on Escape.
      "escape": null
    }
  },
  {
    "context": "SearchInput",
    "bindings": {
      "alt-c": "search::ToggleCase",
      "alt-w": "search::ToggleWholeWord",
      "alt-r": "search::ToggleRegex",
      "alt-f": "search::ToggleFilters",
      "down": "search::SelectNextMatch",
      "escape": "search::Cancel"
    }
  },
  {
    "context": "SearchResults",
    "bindings": {
      "alt-c": "search::ToggleCase",
      "alt-w": "search::ToggleWholeWord",
      "alt-r": "search::ToggleRegex",
      "alt-f": "search::ToggleFilters",
      "down": "search::SelectNextMatch",
      "up": "search::SelectPreviousMatch",
      "enter": "search::OpenMatch",
      "escape": "search::Cancel",
      "secondary-r": "search::Refresh"
    }
  },
  {
    "context": "CommitMessage",
    "bindings": {
      "secondary-enter": "git::Commit"
    }
  },
  {
    "context": "Menu",
    "bindings": {
      "escape": "menu::Cancel"
    }
  },
  {
    "context": "CloseConfirmation",
    "bindings": {
      "enter": "dialog::Confirm",
      "escape": "dialog::Cancel",
      "secondary-d": "dialog::Secondary"
    }
  },
  {
    "context": "CloneRepository",
    "bindings": {
      "enter": "dialog::Confirm",
      "escape": "dialog::Cancel"
    }
  },
  {
    "context": "GitConfirm",
    "bindings": {
      "enter": "dialog::Confirm",
      "escape": "dialog::Cancel"
    }
  },
  {
    // Enter stashes and switches; Bring Changes is a click.
    "context": "StashSwitch",
    "bindings": {
      "enter": "dialog::Confirm",
      "escape": "dialog::Cancel"
    }
  },
  {
    // Other keys edit the branch filter.
    "context": "BranchPicker",
    "bindings": {
      "up": "menu::SelectPrevious",
      "down": "menu::SelectNext",
      "enter": "menu::Confirm",
      "escape": "menu::Cancel"
    }
  }
]
