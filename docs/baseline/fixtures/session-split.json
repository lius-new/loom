          {"size": 0.6, "node": {"pane": {
            "items": ["workspace/lib.rs"],
            "active": "workspace/lib.rs"
          }}}
        ]
      }
    },
    "active_pane": 1
  },
  "terminal_tabs": ["power_shell", "cmd", "bash"],
