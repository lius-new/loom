  "window": {"x": 120, "y": 80, "width": 900.0, "height": 600.0, "maximized": false},
  "editor_layout": {
    "root": {
      "split": {
        "axis": "horizontal",
        "children": [
          {"size": 0.4, "node": {"pane": {
            "items": ["workspace/main.rs", "workspace/中文.txt"],
